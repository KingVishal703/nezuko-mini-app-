<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<title>Player</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.13/dist/hls.min.js"></script>
<script src="config.js"></script>
<style>
  :root{--bg:var(--tg-theme-bg-color,#0f1115);--tx:var(--tg-theme-text-color,#f2f3f5);--hint:var(--tg-theme-hint-color,#8b93a1);--btn:var(--tg-theme-button-color,#2f81f7);--btx:var(--tg-theme-button-text-color,#fff);--card:var(--tg-theme-secondary-bg-color,#181b22)}
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--tx);font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
  .wrap{max-width:900px;margin:0 auto;padding:12px}
  h1{font-size:17px;margin:4px 2px 10px;word-break:break-word}
  .box{position:relative;background:#000;border-radius:14px;overflow:hidden;aspect-ratio:16/9}
  video{width:100%;height:100%;display:block;background:#000}
  .overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.45);pointer-events:none}
  .spin{width:44px;height:44px;border:4px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:s 1s linear infinite}
  @keyframes s{to{transform:rotate(360deg)}}
  .bar{display:flex;align-items:center;gap:10px;margin-top:12px;color:var(--hint);font-size:14px}
  select{background:var(--card);color:var(--tx);border:1px solid rgba(128,128,128,.4);border-radius:8px;padding:8px 10px;font-size:14px}
  .errbox{background:var(--card);border-radius:14px;padding:22px;text-align:center;margin-top:20px}
  .errbox p{margin:0 0 14px}
  button{border:0;border-radius:10px;padding:12px 18px;background:var(--btn);color:var(--btx);font-size:15px;font-weight:600}
  .hide{display:none!important}
</style>
</head>
<body>
<div class="wrap">
  <h1 id="title">Loading…</h1>
  <div class="box" id="box">
    <video id="v" controls playsinline webkit-playsinline preload="auto" controlslist="nodownload"></video>
    <div class="overlay" id="loader"><div class="spin"></div></div>
  </div>
  <div class="bar" id="bar">
    <label for="q">Quality</label>
    <select id="q"><option value="-1">Auto</option></select>
  </div>
  <div class="errbox hide" id="err"><p id="errtxt"></p><button id="errbtn">Wapas jao</button></div>
</div>

<script>
(function(){
  "use strict";
  const tg = window.Telegram && window.Telegram.WebApp;
  if (tg) { tg.ready(); tg.expand(); }
  const API = (window.APP_CONFIG && window.APP_CONFIG.API_BASE || "").replace(/\/$/, "");
  const initData = tg ? tg.initData : "";
  const CODE_RE = /^video[A-Za-z0-9]{3,40}$/;
  const $ = id => document.getElementById(id);
  const code = new URLSearchParams(location.search).get("code") || "";
  const v = $("v");
  let hls = null;

  function backToTimer(){ location.href = "timer.html?code=" + encodeURIComponent(code) + location.hash; }
  function showError(msg, canRetry){
    $("box").classList.add("hide"); $("bar").classList.add("hide");
    $("err").classList.remove("hide"); $("errtxt").textContent = msg;
    $("errbtn").classList.toggle("hide", !canRetry);
    $("errbtn").onclick = backToTimer;
    if (hls) { hls.destroy(); hls = null; }
  }
  const loading = on => $("loader").classList.toggle("hide", !on);

  async function api(path, opts){
    opts = opts || {};
    const headers = {"Content-Type":"application/json","X-Telegram-Init-Data":initData};
    if (opts.grant) headers["X-Grant"] = opts.grant;
    const r = await fetch(API + path, {method: opts.method||"GET", headers,
      body: opts.body ? JSON.stringify(opts.body) : undefined});
    let data = {}; try { data = await r.json(); } catch(e){}
    if (!r.ok) { const e = new Error(data.message || "Request fail ("+r.status+")"); e.code = data.error; e.status = r.status; throw e; }
    return data;
  }

  async function init(){
    // 1. video code validation
    if (!CODE_RE.test(code)) return showError("Video link sahi nahi hai.", false);
    if (!initData) return showError("Ye page sirf Telegram Mini App me chalta hai.", false);
    const grant = sessionStorage.getItem("grant:" + code);
    if (!grant) return backToTimer();               // bina timer/ad ke direct open nahi hoga

    // 2. backend se stream info
    let info;
    try { info = await api("/api/stream/" + encodeURIComponent(code), {grant}); }
    catch(e){
      if (e.status === 404 || e.status === 410) return showError("Ye video hata di gayi hai.", false);
      if (e.status === 401 || e.status === 403) { sessionStorage.removeItem("grant:" + code); return showError("Session khatam ho gaya. Dobara timer se kholo.", true); }
      return showError(e.message || "Video load nahi hui.", true);
    }
    $("title").textContent = info.title || "Video";
    document.title = info.title || "Video";
    setupPlayer(info);
    trackView(grant);
  }

  function setupPlayer(info){
    if (info.poster) v.poster = info.poster;
    const url = info.hls_url;
    if (window.Hls && Hls.isSupported() && url) {
      hls = new Hls({enableWorker:true, startLevel:-1, capLevelToPlayerSize:true,
                     maxBufferLength:30, maxMaxBufferLength:60, manifestLoadingMaxRetry:3, fragLoadingMaxRetry:4});
      hls.loadSource(url);
      hls.attachMedia(v);
      hls.on(Hls.Events.MANIFEST_PARSED, (_, d) => {
        const sel = $("q"), seen = new Set(), heights = [];
        d.levels.forEach((l, i) => { if (l.height && !seen.has(l.height)) { seen.add(l.height); heights.push([l.height, i]); } });
        heights.sort((a,b) => b[0]-a[0]).forEach(([h,i]) => {
          const o = document.createElement("option"); o.value = i; o.textContent = h + "p"; sel.appendChild(o);
        });
        sel.onchange = () => { hls.currentLevel = parseInt(sel.value, 10); };   // -1 = Auto
      });
      let netRetry = 0;
      hls.on(Hls.Events.ERROR, (_, d) => {
        if (!d.fatal) return;
        if (d.type === Hls.ErrorTypes.NETWORK_ERROR && netRetry < 3) { netRetry++; setTimeout(() => hls && hls.startLoad(), 1000 * netRetry); }
        else if (d.type === Hls.ErrorTypes.MEDIA_ERROR) { hls.recoverMediaError(); }
        else {
          const gone = d.response && (d.response.code === 404 || d.response.code === 410);
          showError(gone ? "Ye video hata di gayi hai." : "Video chal nahi paayi. Internet check karke dobara try karo.", !gone);
        }
      });
    } else if (v.canPlayType("application/vnd.apple.mpegurl") && url) {
      v.src = url;                                  // Safari/iOS native HLS (quality Auto)
      $("bar").classList.add("hide");
    } else if (info.mp4_url) {
      v.src = info.mp4_url; $("bar").classList.add("hide");
    } else {
      return showError("Is device par video support nahi hai.", false);
    }
    v.addEventListener("loadedmetadata", () => { v.play().catch(() => {}); }, {once:true});   // open hote hi play
    ["waiting","loadstart","seeking"].forEach(e => v.addEventListener(e, () => loading(true)));
    ["playing","canplay","seeked"].forEach(e => v.addEventListener(e, () => loading(false)));
    v.addEventListener("error", () => { if (!hls) showError("Video chal nahi paayi.", true); });
  }

  // ---------- view tracking: 5 sec asli playback ke baad, sirf ek baar ----------
  function trackView(grant){
    let acc = 0, startedAt = null, sent = false, fails = 0;
    const stop = () => { if (startedAt !== null) { acc += (performance.now() - startedAt) / 1000; startedAt = null; } };
    v.addEventListener("playing", () => { if (startedAt === null) startedAt = performance.now(); });
    ["pause","waiting","ended","seeking"].forEach(e => v.addEventListener(e, stop));
    const iv = setInterval(async () => {
      if (sent) return;
      const total = acc + (startedAt !== null ? (performance.now() - startedAt) / 1000 : 0);
      if (total < 5) return;
      sent = true;
      try {
        await api("/api/view", {method:"POST", grant, body:{code, watched_seconds: Math.floor(total)}});
        clearInterval(iv);
      } catch(e){
        if (e.status === 401 || e.status === 403 || ++fails >= 3) clearInterval(iv);
        else sent = false;                          // network error: thodi der baad retry
      }
    }, 1000);
  }

  init();
})();
</script>
</body>
</html>
