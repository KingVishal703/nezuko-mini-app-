<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<title>Video</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<script src="config.js"></script>
<style>
  :root{--bg:var(--tg-theme-bg-color,#0f1115);--tx:var(--tg-theme-text-color,#f2f3f5);--hint:var(--tg-theme-hint-color,#8b93a1);--btn:var(--tg-theme-button-color,#2f81f7);--btx:var(--tg-theme-button-text-color,#fff);--card:var(--tg-theme-secondary-bg-color,#181b22)}
  *{box-sizing:border-box}
  body{margin:0;min-height:100vh;background:var(--bg);color:var(--tx);font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;display:flex;align-items:center;justify-content:center;padding:20px}
  .card{width:100%;max-width:420px;background:var(--card);border-radius:18px;padding:24px;text-align:center}
  h1{font-size:18px;margin:0 0 6px;word-break:break-word}
  .sub{color:var(--hint);font-size:13px;margin-bottom:22px}
  .ring{width:120px;height:120px;margin:0 auto 14px;position:relative}
  .ring svg{transform:rotate(-90deg)}
  .ring .num{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:34px;font-weight:700}
  .track{stroke:rgba(128,128,128,.25)} .prog{stroke:var(--btn);transition:stroke-dashoffset .25s linear}
  button{width:100%;border:0;border-radius:12px;padding:14px;font-size:16px;font-weight:600;background:var(--btn);color:var(--btx);margin-top:10px}
  button.sec{background:transparent;color:var(--tx);border:1px solid rgba(128,128,128,.4)}
  button:disabled{opacity:.4}
  .msg{margin-top:14px;font-size:14px;min-height:20px}
  .err{color:#ff6b6b}.ok{color:#3fb950}
  .hide{display:none}
</style>
</head>
<body>
<div class="card">
  <h1 id="title">Loading…</h1>
  <div class="sub" id="sub">Please wait</div>
  <div class="ring">
    <svg width="120" height="120" viewBox="0 0 120 120">
      <circle class="track" cx="60" cy="60" r="52" fill="none" stroke-width="8"/>
      <circle class="prog" id="prog" cx="60" cy="60" r="52" fill="none" stroke-width="8" stroke-linecap="round"/>
    </svg>
    <div class="num" id="num">…</div>
  </div>
  <div id="actions" class="hide">
    <button id="btnPlay" disabled>▶ Mini App me dekho</button>
    <button id="btnBot" class="sec" disabled>📩 Bot me video lo</button>
  </div>
  <div class="msg" id="msg"></div>
</div>

<script>
(function(){
  "use strict";
  const tg = window.Telegram && window.Telegram.WebApp;
  if (tg) { tg.ready(); tg.expand(); }
  const API = (window.APP_CONFIG && window.APP_CONFIG.API_BASE || "").replace(/\/$/, "");
  const initData = tg ? tg.initData : "";
  const CODE_RE = /^video[A-Za-z0-9]{3,40}$/;
  const $ = id => document.getElementById(id);
  const code = new URLSearchParams(location.search).get("code") || "";

  const C = 2 * Math.PI * 52;
  $("prog").style.strokeDasharray = C;
  $("prog").style.strokeDashoffset = C;

  function setMsg(t, cls){ const m=$("msg"); m.textContent=t||""; m.className="msg "+(cls||""); }

  async function api(path, opts){
    opts = opts || {};
    const headers = {"Content-Type":"application/json","X-Telegram-Init-Data":initData};
    const r = await fetch(API + path, {method: opts.method||"GET", headers,
      body: opts.body ? JSON.stringify(opts.body) : undefined});
    let data = {}; try { data = await r.json(); } catch(e){}
    if (!r.ok) { const e = new Error(data.message || "Request fail ("+r.status+")"); e.code = data.error; e.status = r.status; throw e; }
    return data;
  }
  const sleep = ms => new Promise(r => setTimeout(r, ms));

  // ---------- Ad adapters (naya network = naya adapter) ----------
  const loaded = {};
  function loadScript(src, attrs){
    const key = src + JSON.stringify(attrs||{});
    if (loaded[key]) return loaded[key];
    loaded[key] = new Promise((res, rej) => {
      const s = document.createElement("script"); s.src = src; s.async = true;
      Object.entries(attrs||{}).forEach(([k,v]) => s.setAttribute(k, v));
      s.onload = res; s.onerror = () => rej(new Error("Ad SDK load nahi hua"));
      document.head.appendChild(s);
    });
    return loaded[key];
  }
  const ADAPTERS = {
    async adsgram(ad){
      await loadScript("https://sad.adsgram.ai/js/sad.min.js");
      if (!window.Adsgram) return {ok:false, reason:"sdk_missing"};
      const ctl = window.Adsgram.init({blockId: String(ad.block_id)});
      try {
        const r = await ctl.show();               // resolve = ad poora dekha
        return {ok: !!(r && r.done), reason: r && r.description};
      } catch (r) {                               // reject = skip / error / no fill
        return {ok:false, reason: (r && r.description) || "adsgram_error"};
      }
    },
    async monetag(ad){                            // Monetag dashboard wala snippet check kar lena
      const fn = "show_" + ad.zone;
      await loadScript(ad.sdk_url || "https://libtl.com/sdk.js", {"data-zone": ad.zone, "data-sdk": fn});
      if (typeof window[fn] !== "function") return {ok:false, reason:"sdk_missing"};
      try { await window[fn]({ymid: ad.ymid}); return {ok:true}; }
      catch(e){ return {ok:false, reason:"monetag_error"}; }
    }
  };

  // ---------- state ----------
  let gateId = null, timerDone = false, busy = false;

  async function init(){
    if (!CODE_RE.test(code)) { $("title").textContent = "Link sahi nahi hai"; $("sub").textContent = ""; $("num").textContent = "✕"; return; }
    if (!initData) { $("title").textContent = "Telegram me kholo"; $("sub").textContent = "Ye page sirf Telegram Mini App me chalta hai."; $("num").textContent = "✕"; return; }
    try {
      const info = await api("/api/video/" + encodeURIComponent(code));
      $("title").textContent = info.title || "Video";
      $("sub").textContent = "Video kholne se pehle thoda wait karo";
      const g = await api("/api/gate/start", {method:"POST", body:{code}});
      gateId = g.gate_id;
      startTimer(g.timer_seconds || info.timer_seconds || 10);
    } catch(e){
      $("title").textContent = e.status === 404 || e.status === 410 ? "Video available nahi hai" : "Error";
      $("sub").textContent = e.message; $("num").textContent = "✕";
    }
  }

  // timer sirf tab chalta hai jab page visible ho
  function startTimer(total){
    let left = total, last = performance.now();
    $("actions").classList.remove("hide");
    const iv = setInterval(() => {
      const now = performance.now();
      if (!document.hidden) left -= (now - last) / 1000;
      last = now;
      const shown = Math.max(0, Math.ceil(left));
      $("num").textContent = shown;
      $("prog").style.strokeDashoffset = C * (1 - Math.min(1, (total - Math.max(left,0)) / total));
      if (left <= 0) {
        clearInterval(iv); timerDone = true;
        $("num").textContent = "✓";
        $("btnPlay").disabled = false; $("btnBot").disabled = false;
        $("sub").textContent = "Ab button dabao";
      }
    }, 250);
  }

  async function complete(ad, res){
    for (let i = 0; i < 8; i++) {
      const r = await api("/api/ad/complete", {method:"POST", body:{
        gate_id: gateId, ad_id: ad.ad_id, result: res.ok ? "done" : "failed", reason: res.reason || ""}});
      if (r.status !== "pending") return r;
      await sleep(1000);                          // server-side ad verification ka wait
    }
    return {status:"failed", message:"Verification me der lag rahi hai"};
  }

  async function go(action){
    if (busy || !timerDone) return;
    busy = true; $("btnPlay").disabled = $("btnBot").disabled = true;
    setMsg("Please wait…");
    try {
      let data = await api("/api/ad/request", {method:"POST", body:{gate_id: gateId, action}});
      let tries = 0;
      while (data.ad) {                           // server batata hai kaunsa network
        setMsg("Ad load ho raha hai…");
        const adapter = ADAPTERS[data.ad.network];
        const res = adapter ? await adapter(data.ad) : {ok:false, reason:"unsupported_network"};
        const r = await complete(data.ad, res);
        if (r.status === "verified") { data = r; break; }
        if (r.next_ad && ++tries < 4) { data = {ad: r.next_ad}; continue; }   // doosra network try
        throw new Error(r.message || "Ad verify nahi hua. Dobara try karo.");
      }
      finish(action, data);
    } catch(e){
      setMsg(e.message || "Kuch gadbad hui", "err");
      busy = false; $("btnPlay").disabled = $("btnBot").disabled = false;
    }
  }

  function finish(action, data){
    if (action === "play") {
      if (!data.grant) throw new Error("Permission nahi mili");
      sessionStorage.setItem("grant:" + code, data.grant);
      location.href = "player.html?code=" + encodeURIComponent(code) + location.hash;   // Telegram hash safe
    } else {
      if (!data.bot_link) throw new Error("Bot link nahi mila");
      setMsg("Bot me video bhej di gayi hai ✅", "ok");
      if (tg && tg.openTelegramLink) tg.openTelegramLink(data.bot_link); else location.href = data.bot_link;
      busy = false; $("btnPlay").disabled = $("btnBot").disabled = false;
    }
  }

  $("btnPlay").onclick = () => go("play");
  $("btnBot").onclick = () => go("bot");
  init();
})();
</script>
</body>
</html>
